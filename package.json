{
  "name": "pulse-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w pulse-demo -- --port 5173",
    "dev:ha": "npm run dev -w pulse-home-assistant -- --port 5174",
    "build": "tsc --noEmit && npm run build --workspaces --if-present",
    "build:card": "npm run build:card -w pulse-home-assistant",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@zumer/orbit": "^2.2.0",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "zumly": "^1.2.2"
  }
}
